[Theory]
        [InlineData(1, "BÁSICO")]
        [InlineData(2, "PADRÃO")]
        [InlineData(4, "PREMIUM")]
        [InlineData(5, "PREMIUM")]
        public void DeveRetornarClassificacaoCorreta(
            int telasSimultaneas,
            string esperado)
        {
            var resultado =
                _service.ObterClassificacaoPorQualidade(
                    telasSimultaneas);

            Assert.Equal(esperado, resultado);
        }

        [Theory]
        [InlineData(50, 1, 50)]
        [InlineData(50, 5, 50)]
        [InlineData(50, 6, 45)]
        [InlineData(50, 11, 45)]
        [InlineData(50, 12, 40)]
        [InlineData(50, 24, 40)]
        public void DeveCalcularMensalidadeComDesconto(
            int valorBase,
            int mesesContratados,
            decimal esperado)
        {
            var resultado =
                _service.CalcularMensalidadeComDesconto(
                    valorBase,
                    mesesContratados);

            Assert.Equal(esperado, resultado);
        }

        [Theory]
        [InlineData(18, false, true)]
        [InlineData(25, false, true)]
        [InlineData(17, false, false)]
        [InlineData(18, true, false)]
        [InlineData(30, true, false)]
        public void DeveVerificarAcessoAoConteudoAdulto(
            int idade,
            bool controleParentalAtivo,
            bool esperado)
        {
            var resultado =
                _service.PodeAcessarConteudoAdulto(
                    idade,
                    controleParentalAtivo);

            Assert.Equal(esperado, resultado);
        }
    }
